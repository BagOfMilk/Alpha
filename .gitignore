# Unity generated.
# Пути НАЧИНАЮТСЯ СО СЛЭША намеренно: правило без слэша действует на любой
# вложенности, и «Build/» съедало исходники Core/Characters/Build (планировщик
# билда персонажа). Такая пропажа не видна: git молчит, локально всё собирается,
# а на другой машине ветка не компилируется.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Visual Studio / Rider / VS Code
.vs/
.idea/
.vscode/
*.csproj
*.sln

# Headless-проекты для прогона тестов ядра без Unity — их коммитим.
# (Правила выше существуют потому, что Unity генерирует свои csproj/sln.)
!tools/**/*.csproj
!tools/**/*.sln
tools/**/bin/
tools/**/obj/
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.suo

# Рабочая папка MCP-сервера Serena — индекс проекта, не исходники
.serena/

# Личные настройки Claude Code (командные лежат в .claude/settings.json)
.claude/settings.local.json

# OS / misc
.DS_Store
Thumbs.db
*.tmp
*.bak
crashlytics-build.properties
sysinfo.txt

# Трассы симуляционного харнеса (tools/Alpha.Sim)
sim-out/
