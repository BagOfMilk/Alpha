  m_GameObject: {fileID: 1025785137}
  m_Text: "\u0422\u0438\u0445\u043E\n\u0427\u0442\u043E-\u0442\u043E \u043D\u0430\u0437\u0440\u0435\u0432\u0430\u0435\u0442\n\u0422\u0438\u0445\u043E\n\u0422\u0440\u0435\u0432\u043E\u0436\u043D\u043E:
    \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u044B \u043F\u0440\u043E \u0443\u043B\u0438\u0446\u044B\n\u0417\u0430\u043F\u0430\u0441\u044B
    \u043F\u043E\u0440\u0442\u044F\u0442\u0441\u044F \u2014 \u043A\u043E\u0435-\u043A\u0430\u043A
    \u0443\u043B\u0430\u0434\u0438\u043B\u0438\n\u0411\u0435\u0434\u0430 \u0431\u043B\u0438\u0437\u043A\u043E,
    \u0438 \u043E\u043D\u0430 \u043F\u0440\u043E \u0443\u043B\u0438\u0446\u044B\n\u0422\u0438\u0445\u043E\n\u0411\u043E\u043B\u044C\u043D\u043E\u0439
    \u0440\u0435\u0431\u0451\u043D\u043E\u043A \u2014 \u043A\u043E\u0435-\u043A\u0430\u043A
    \u0443\u043B\u0430\u0434\u0438\u043B\u0438\n\u0422\u0438\u0445\u043E"
