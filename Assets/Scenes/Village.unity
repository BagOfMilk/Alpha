--- !u!102 &771384002
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 771384001}
  m_Text: "\u0422\u0440\u0435\u0432\u043E\u0436\u043D\u043E: \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u044B
    \u043F\u0440\u043E \u0443\u043B\u0438\u0446\u044B\n\u0422\u0438\u0445\u043E\n\u0417\u0430\u043F\u0430\u0441\u044B
    \u043F\u043E\u0440\u0442\u044F\u0442\u0441\u044F \u2014 \u043A\u043E\u0435-\u043A\u0430\u043A
    \u0443\u043B\u0430\u0434\u0438\u043B\u0438\n\u0411\u0435\u0434\u0430 \u0431\u043B\u0438\u0437\u043A\u043E,
    \u0438 \u043E\u043D\u0430 \u043F\u0440\u043E \u0443\u043B\u0438\u0446\u044B\n\u0425\u0443\u0442\u043E\u0440
    \u0441\u0442\u0430\u043B \u0441\u0435\u043B\u043E\u043C\n\u0422\u0438\u0445\u043E\n\u0421\u043E\u0432\u0435\u0442
    \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442 \u043F\u0435\u0440\u0435\u0441\u0435\u043B\u0435\u043D\u0446\u0435\u0432\n\u041F\u0440\u0438\u0448\u043B\u0438
    \u043B\u044E\u0434\u0438 (10): \u043F\u043E\u0437\u0432\u0430\u043B \u0441\u043E\u0432\u0435\u0442\n\u0422\u0438\u0445\u043E"
  m_OffsetZ: 0
  m_CharacterSize: 0.11
  m_LineSpacing: 1
