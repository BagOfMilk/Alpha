  "fonts": {
    "display900": "Assets/ThirdParty/Fonts/FiraSansExtraCondensed/FiraSansExtraCondensed-Black.ttf",
    "display800": "Assets/ThirdParty/Fonts/FiraSansExtraCondensed/FiraSansExtraCondensed-ExtraBold.ttf",
    "display700": "Assets/ThirdParty/Fonts/FiraSansExtraCondensed/FiraSansExtraCondensed-Bold.ttf",
    "hand":       "Assets/ThirdParty/Fonts/AmaticSC/AmaticSC-Bold.ttf",
    "text":       "Assets/ThirdParty/Fonts/Fixel/FixelText-SemiBold.ttf"
  },
  "easing": ["l", "o2", "o3", "i2", "i3", "io2", "ob", "s"],
