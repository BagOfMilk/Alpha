    { "id": "dzhura",   "nick": "Колібрі",  "full": "Матео Рамос",       "gimmick": "flyer",      "role": "hero",    "player": false },
    { "id": "vdova",    "nick": "Вдова",    "full": "Мей Лін",           "gimmick": "technician", "role": "villain", "player": false },
    { "id": "baron",    "nick": "Барон",    "full": "Олівер Вінслоу",    "gimmick": "showman",    "role": "villain", "player": false },
    { "id": "hammer",   "nick": "Молот",    "full": "Тарас Гребінь",     "gimmick": "monster",    "role": "villain", "player": false },
    { "id": "komet",    "nick": "Комета",   "full": "Амара Окафор",      "gimmick": "flyer",      "role": "hero",    "player": false },
