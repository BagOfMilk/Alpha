{
  "version": 1,
  "note": "Дані генератора екранів виходу (див. docs/ring/design/briefs/B07_entrance_screen.md). Кольори — лише слоти `$…` (карта нижче) або імена токенів brand_tokens.json; прозорість — лише кроки з `alpha`. Власник палітри — арт-директор. Числа ритму й розкладки — ПЛЕЙСХОЛДЕР до перегляду в грі.",
  "frame": { "w": 1024, "h": 512 },
  "alpha": { "ghost": "tronGhost", "dim": "tronDim", "mid": "tronMid" },
  "playerSlots": { "$accent": "gold", "$flash": "gold" },
  "monoSlots": { "$roleText": "paper", "$cool": "paper", "$flash": "paper", "$ground2": "ink0" },
  "variants": 4,
  "roles": ["hero", "villain", "rebel"],
  "tiersOrder": ["gym", "hall", "arena"],
  "slots": {
    "hero":    { "$role": "cobalt",  "$roleText": "cobaltText", "$flash": "cobaltText", "$shadow": "ink0", "$onRole": "paper", "$accent": "paper", "$cool": "frost", "$ground": "ink0", "$ground2": "ink1", "$paper": "paper" },
    "villain": { "$role": "crimson", "$roleText": "signal",     "$flash": "signal",     "$shadow": "ink0", "$onRole": "paper", "$accent": "paper", "$cool": "frost", "$ground": "ink0", "$ground2": "ink1", "$paper": "paper" },
    "rebel":   { "$role": "rose",    "$roleText": "rose",       "$flash": "rose",       "$shadow": "paper", "$onRole": "ink0",  "$accent": "paper", "$cool": "frost", "$ground": "ink0", "$ground2": "ink1", "$paper": "paper" }
  },
  "tiers": {
    "gym":   { "fps": 6,  "hitBeat": 2, "maxLayers": 12, "mono": true,  "handFont": true,  "scan": true,  "label": "спортзал: проєктор на простирадлі" },
    "hall":  { "fps": 12, "hitBeat": 2, "maxLayers": 18, "mono": false, "handFont": false, "scan": false, "label": "клуб: ТВ-панелі" },
    "arena": { "fps": 30, "hitBeat": 4, "maxLayers": 30, "mono": false, "handFont": false, "scan": false, "label": "Палац: LED-стіна" }
  },
  "gimmicks": {
    "monster":    { "bpm": 100 },
    "flyer":      { "bpm": 132 },
    "technician": { "bpm": 112 },
    "showman":    { "bpm": 120 }
