<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless-прогон тестов из Assets/Tests/EditMode.
    Те же файлы, что видит Unity Test Runner, плюс один локальный shim
    (UnityShim.cs), которого Unity никогда не увидит — он лежит вне Assets/.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>

    <!-- КРИТИЧНО: ровно это имя стоит в InternalsVisibleTo внутри ядра.
         Любое другое — и тесты потеряют доступ к internal-членам (CS0122). -->
    <AssemblyName>Game.Tests.EditMode</AssemblyName>
    <RootNamespace>Game.Tests</RootNamespace>

    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <!-- Unity 6 компилирует тесты как C# 9: всё новее сломает сборку в редакторе. -->
    <LangVersion>9.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Tests/EditMode/**/*.cs" />
    <Compile Include="UnityShim.cs" />
    <!--
      Слой показа (VillageView) живёт в Game.Gameplay, но не содержит ни одного
      типа движка — поэтому headless-тесты берут его исходником напрямую.
      Так правила показа проверяются обычными тестами, а не глазами на снимке.
    -->
    <Compile Include="../../Assets/_Project/Scripts/Gameplay/VillageView.cs" />
    <!--
      Б1 (R1): SeededDiceRoller — чистый C# без UnityEngine, реализация
      IDiceRoller для тестов детерминизма/автобоя. Тем же приёмом, что и
      VillageView.cs выше, и UkrainianText.cs ниже (пакет E3b) в Alpha.Play.
    -->
    <Compile Include="../../Assets/_Project/Scripts/Gameplay/Combat/SeededDiceRoller.cs" />
    <!--
      E3 (R7): UkrainianText — чистый C# без UnityEngine, единая текстовая
      таблица. Тем же приёмом, что и VillageView.cs/SeededDiceRoller.cs выше:
      headless-тесты (UkrainianTextTests.cs) берут её исходником напрямую.
    -->
    <Compile Include="../../Assets/_Project/Scripts/Gameplay/Text/UkrainianText.cs" />
    <!--
      E1b: ScreenText — чистий C# формат/легальність для екранів (Gameplay/
      UI/*Screen.cs), тим самим прийомом, що UkrainianText.cs/VillageView.cs
      вище: headless-тести (ScreenTextTests.cs) беруть його з джерела напряму.
    -->
    <Compile Include="../../Assets/_Project/Scripts/Gameplay/UI/ScreenText.cs" />
    <!--
      Журнал бою: BattleLogText — чистий C# (ключі combat.log.* з BattleView.Log
      -> українські рядки), тим самим прийомом: BattleLogTextTests.cs бере його
      з джерела напряму.
    -->
    <Compile Include="../../Assets/_Project/Scripts/Gameplay/UI/BattleLogText.cs" />
    <!-- Бій v2: чисті типи контракту (BattleLogKind тощо), на які спирається BattleLogText. -->
    <Compile Include="../../Assets/_Project/Scripts/Gameplay/UI/BattleUiTypes.cs" />

    <!--
      E2: BattleArenaView — чистий C# без UnityEngine, розкладкова математика
      арени (тайл→світ, кадрування камери, детермінована палітра юнітів).
      Той самий прийом, що VillageView.cs/UkrainianText.cs вище:
      BattleArenaViewTests.cs бере її джерелом напряму.
    -->
    <Compile Include="../../Assets/_Project/Scripts/Gameplay/BattleArenaView.cs" />
    <!--
      Бій v2 (3D-подача, docs/COMBAT_V2.md §5-§7): режисер ходу ворога і
      розбір шляху руху з журналу — обидва чистий C#, тим самим прийомом.
      BattleTurnDirectorTests.cs/BattleTactParserTests.cs беруть їх з джерела.
    -->
    <Compile Include="../../Assets/_Project/Scripts/Gameplay/BattleTurnDirector.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Gameplay/BattleTactParser.cs" />
    <!--
      Прогулянка селом: WalkGrid/VillagePlaces — чистий C# (сітка, A*, місця
      взаємодії). HeroWalker у сцені лише застосовує — VillageWalkTests.cs
      бере модель з джерела напряму.
    -->
    <Compile Include="../../Assets/_Project/Scripts/Gameplay/Walk/VillageWalk.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- NUnit 3.x, а НЕ 4.x: в четвёртой версии классический API
         (Assert.AreEqual/IsTrue/Greater/IsEmpty) переехал в ClassicAssert,
         и все наши тесты перестали бы компилироваться. -->
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Game.Core.Headless/Game.Core.csproj" />
  </ItemGroup>

</Project>
