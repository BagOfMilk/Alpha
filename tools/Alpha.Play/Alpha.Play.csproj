<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Консольная сборка первого часа (docs/FIRST_HOUR.md §4 п. 6).

    Зачем отдельный инструмент, а не сцена в Unity: срез первого часа нужно
    ПРОЙТИ и измерить задолго до интерфейса. Текстовая сборка играется уже
    сегодня, а на вопрос «цепляет ли петля» отвечает тем же ядром, что и игра.

    Мир строится общим с харнесом кодом (tools/Shared): иначе замеренный темп
    относился бы не к той игре, в которую играли.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Alpha.Play</AssemblyName>
    <RootNamespace>Alpha.Play</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Game.Core.Headless/Game.Core.csproj" />
    <!--
      Пакет D2: Alpha.Play більше не будує світ сам (SettlementWorld.cs
      прибрано — тонкий делегат до FirstHourWorld лишився без жодного
      споживача, GameSession будує світ сам усередині NewGame). SignalText/
      SceneText лишаються — Program.cs друкує через них ключі, доки E3 не
      завела справжню текстову таблицю (§6.2 TEST_BUILD.md).
    -->
    <Compile Include="../Shared/SignalText.cs" Link="Shared/SignalText.cs" />
    <Compile Include="../Shared/SceneText.cs" Link="Shared/SceneText.cs" />
    <!-- Б1 (R1): сидированный кубик боя, чистый C# без UnityEngine. -->
    <Compile Include="../../Assets/_Project/Scripts/Gameplay/Combat/SeededDiceRoller.cs"
             Link="Gameplay/Combat/SeededDiceRoller.cs" />
  </ItemGroup>

</Project>
