<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Консольная сборка первого часа (docs/FIRST_HOUR.md §4 п. 6).

    Зачем отдельный инструмент, а не сцена в Unity: срез первого часа нужно
    ПРОЙТИ и измерить задолго до интерфейса. Текстовая сборка играется уже
    сегодня, а на вопрос «цепляет ли петля» отвечает тем же ядром, что и игра.

    Мир строится тим самим GameSession, що й Unity/тести (SettlementWorld.cs
    прибрано пакетом D2 — GameSession будує світ сам усередині NewGame).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Alpha.Play</AssemblyName>
    <RootNamespace>Alpha.Play</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Game.Core.Headless/Game.Core.csproj" />
    <!-- Б1 (R1): сидированный кубик боя, чистый C# без UnityEngine. -->
    <Compile Include="../../Assets/_Project/Scripts/Gameplay/Combat/SeededDiceRoller.cs"
             Link="Gameplay/Combat/SeededDiceRoller.cs" />
    <!--
      Пакет E3b (R7): єдина текстова таблиця, чистий C# без UnityEngine —
      той самий прийом Compile Include, що вже є для SeededDiceRoller.cs
      вище. Замінила Alpha.Shared.SceneText/SignalText (tools/Shared/,
      видалено цим пакетом): Program.cs друкує через неї, як і Unity.
    -->
    <Compile Include="../../Assets/_Project/Scripts/Gameplay/Text/UkrainianText.cs"
             Link="Gameplay/Text/UkrainianText.cs" />
  </ItemGroup>

</Project>
