<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Линт Unity-обёрток: компилирует Game.Gameplay с заглушкой UnityEngine,
    чтобы обычные ошибки C# ловились здесь, а не через запуск редактора.
    Это ПРОВЕРКА СБОРКИ, а не замена Unity: поведение движка не эмулируется.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>Game.Gameplay.Lint</AssemblyName>
    <RootNamespace>Game.Gameplay</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Заглушка объявляет пустые атрибуты: неиспользуемые параметры — норма. -->
    <NoWarn>$(NoWarn);CS0169;CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="UnityEngineStub.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Gameplay/**/*.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Editor/**/*.cs" />

    <!--
      Сборщик сцены и настройки импорта чужих наборов НЕ линтуются.
      Они ходят в глубину редактора и рендера (PrefabUtility, ModelImporter,
      RenderTexture, примитивы, свет), и честно смоделировать этот API
      заглушками нельзя: заглушка молча разошлась бы с настоящей сигнатурой, и
      линт давал бы ложное «собирается». Их проверяет сам Unity — оба скрипта
      запускаются в batch-режиме при сборке сцены и снимке.
    -->
    <Compile Remove="../../Assets/_Project/Scripts/Gameplay/VillageLife.cs" />
    <Compile Remove="../../Assets/_Project/Scripts/Editor/VillageShowcase.cs" />
    <Compile Remove="../../Assets/_Project/Scripts/Editor/KenneyImportSettings.cs" />
    <!-- B8: общие примитивы VillageShowcase (PrefabUtility/ModelImporter-соседи,
         TextMesh, AssetDatabase.CreateAsset…) — та же причина исключения. -->
    <Compile Remove="../../Assets/_Project/Scripts/Editor/KitBuilder.cs" />

    <!--
      E1: та же причина, тот же принцип, что и у VillageLife/VillageShowcase
      выше. VillageStage — компонент сцены (Light/Camera/Renderer/Material/
      Shader.Find, RenderSettings), GameSceneBuilder — сборщик сцены
      (PrefabUtility, ModelImporter-соседи через KitBuilder, UniversalAdditio-
      nalCameraData). Настоящий Unity проверяет их сам в batch-режиме при
      сборке сцены «Игра» (см. tools/build-unity.ps1) — заглушка честно не
      покрыла бы этот API без риска молча разойтись с настоящими сигнатурами.
    -->
    <Compile Remove="../../Assets/_Project/Scripts/Gameplay/VillageStage.cs" />
    <Compile Remove="../../Assets/_Project/Scripts/Editor/GameSceneBuilder.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Game.Core.Headless/Game.Core.csproj" />
  </ItemGroup>

</Project>
